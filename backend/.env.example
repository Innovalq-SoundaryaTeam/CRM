# PostgreSQL connection string
# Format: postgresql://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://crm_user:crm_password@localhost:5432/candidate_crm

# JWT settings
# Generate a strong random secret, e.g. with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# CORS - comma separated list of allowed origins serving the frontend
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000
